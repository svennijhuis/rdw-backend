# Comma-separated list of client API keys accepted by this service.
# Sent by clients via the X-Api-Key header (preferred) or ?api_key= query param.
VALID_API_KEYS=example-key-1,example-key-2

# Optional. RDW Socrata app token, sent as X-App-Token to opendata.rdw.nl.
# When absent, requests use Socrata's unauthenticated (lower) rate tier.
# The service starts and functions without it.
RDW_APP_TOKEN=

# Log level / filter for tracing-subscriber (e.g. info, debug, rdw_api=debug).
RUST_LOG=info

# Port the HTTP server listens on.
SERVER_PORT=3000
